# Copy to .env.local and fill in. Never commit real values.

# Neon — pooled URL for the app, direct (unpooled) URL for migrations.
# `npx neon@latest env pull` writes both.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Clerk — keys from Clerk Dashboard → Configure → API Keys (development instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Provisioning is explicit; never grant a role automatically on signup.
SEED_ADMIN_EMAIL=
NEON_BRANCH=main
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Local dev only: skip Clerk login and act as ADMIN|STAFF|USER (first active member). Ignored when NODE_ENV=production.
# ZIGGY_DEV_AUTH_ROLE=ADMIN

# Local presentation demo sign-in (see src/server/auth/dev-login.ts). Fail-closed; ignored in production.
# ZIGGY_DEV_LOGIN=1
# NEXT_PUBLIC_ZIGGY_DEV_LOGIN=1   (shows Sign out instead of the Clerk button)
# ZIGGY_DEV_SESSION_SECRET=<any random string, 16+ chars>
